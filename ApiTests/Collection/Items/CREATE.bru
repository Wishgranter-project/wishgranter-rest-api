meta {
  name: CREATE
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/users/regular-user/collection/items
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  title: music title
  playlist: music-metal
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
}
