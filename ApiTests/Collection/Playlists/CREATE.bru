meta {
  name: CREATE
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/users/regular-user/collection/playlists
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  title: Random name for a playlist
  description: This is the playlist's description.
}

assert {
  res.status: eq 201
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Creates a new playlist.
  
}
